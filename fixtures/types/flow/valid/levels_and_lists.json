{
  "id": "tv_stopped_or_dusk",
  "name": "TV stopped or dusk",
  "nodes": {
    "stopped": { "type": "trigger", "trigger": { "type": "state", "entity": "sensor.demo_tv_state", "to": ["paused", "idle", "off"], "for": "2s" } },
    "got_dark": { "type": "trigger", "trigger": { "type": "state", "entity": "sensor.demo_luminosity_illuminance", "below": 600, "for": "30s" } },
    "on": { "type": "call", "service": "light.turn_on", "entity": "light.demo_tv_area_lights" }
  },
  "wires": [["stopped", "on"], ["got_dark", "on"]]
}
