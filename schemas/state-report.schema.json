{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StateReport",
  "description": "A new value for one entity, from its protocol. The core adds the timestamps and context,\nand checks the value against the entity's kind and capabilities.\n\nReporting a value doesn't change the entity's availability; that's reported separately.",
  "type": "object",
  "properties": {
    "attributes": {
      "description": "Replaces all of the entity's attributes. Leave out to clear them.",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/AttributeKey"
      }
    },
    "caused_by": {
      "description": "The context of the service call that caused this change, when the protocol knows it\n(e.g. the device confirmed a command). Otherwise the change is attributed to the device.",
      "anyOf": [
        {
          "$ref": "#/$defs/ContextId"
        },
        {
          "type": "null"
        }
      ]
    },
    "state": {
      "description": "The typed value, or `null` if the device doesn't know it (e.g. it just restarted). Must be\npresent even when `null`.",
      "anyOf": [
        {
          "$ref": "#/$defs/State"
        },
        {
          "type": "null"
        }
      ]
    },
    "unique_id": {
      "$ref": "#/$defs/UniqueId"
    }
  },
  "additionalProperties": false,
  "required": [
    "unique_id",
    "state"
  ],
  "$defs": {
    "AttributeKey": {
      "description": "Format of a slug (attribute key): lowercase letters a-z and digits, in words separated by single `_`. 1-64 characters.",
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"
    },
    "ColorMode": {
      "type": "string",
      "enum": [
        "color_temp",
        "rgb"
      ]
    },
    "ContextId": {
      "description": "A ULID: 26 characters, uppercase Crockford base32.",
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "SensorValue": {
      "description": "A sensor reading: a finite number or text, matching the sensor's `value_type`.",
      "anyOf": [
        {
          "type": "number",
          "maximum": 1.7976931348623157e+308,
          "minimum": -1.7976931348623157e+308
        },
        {
          "type": "string"
        }
      ]
    },
    "State": {
      "description": "A typed value, tagged with the entity kind it belongs to.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "brightness": {
              "description": "1-255, when the light supports dimming. Kept while off: the level it returns to.",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint8",
              "maximum": 255,
              "minimum": 1
            },
            "color_mode": {
              "description": "Which color setting is active, when the light supports more than one.",
              "anyOf": [
                {
                  "$ref": "#/$defs/ColorMode"
                },
                {
                  "type": "null"
                }
              ]
            },
            "color_temp_kelvin": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint16",
              "maximum": 20000,
              "minimum": 1000
            },
            "kind": {
              "type": "string",
              "const": "light"
            },
            "on": {
              "type": "boolean"
            },
            "rgb": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "integer",
                "format": "uint8",
                "maximum": 255,
                "minimum": 0
              },
              "maxItems": 3,
              "minItems": 3
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "on"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "switch"
            },
            "on": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "on"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "sensor"
            },
            "value": {
              "$ref": "#/$defs/SensorValue"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "binary_sensor"
            },
            "on": {
              "description": "`true` means detected/open/wet/etc., depending on the device class.",
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "on"
          ]
        }
      ]
    },
    "UniqueId": {
      "description": "Stable id assigned by the protocol (e.g. a Zigbee IEEE address). Unique within the protocol.",
      "type": "string",
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$"
    }
  }
}
