{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StateReport",
  "description": "A new value for one entity, from its protocol. The core adds the timestamps and context,\nand checks the value against the entity's kind and capabilities.\n\nReporting a value doesn't change the entity's availability; that's reported separately.",
  "type": "object",
  "properties": {
    "attributes": {
      "description": "Replaces all of the entity's attributes. Leave out to clear them.",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/AttributeKey"
      }
    },
    "caused_by": {
      "description": "The context of the service call that caused this change, when the protocol knows it\n(e.g. the device confirmed a command). Otherwise the change is attributed to the device.",
      "anyOf": [
        {
          "$ref": "#/$defs/ContextId"
        },
        {
          "type": "null"
        }
      ]
    },
    "replayed": {
      "description": "The protocol is repeating what it last heard rather than hearing something new, e.g. a\nretained MQTT message delivered on (re)subscribing. For an `event`, whose every report is\nan occurrence, a replayed one sets the value without counting as something happening.",
      "type": "boolean"
    },
    "state": {
      "description": "The typed value, or `null` if the device doesn't know it (e.g. it just restarted). Must be\npresent even when `null`.",
      "anyOf": [
        {
          "$ref": "#/$defs/State"
        },
        {
          "type": "null"
        }
      ]
    },
    "unique_id": {
      "$ref": "#/$defs/UniqueId"
    }
  },
  "additionalProperties": false,
  "required": [
    "unique_id",
    "state"
  ],
  "$defs": {
    "AlarmStatus": {
      "description": "What a panel is doing. Home Assistant's `AlarmControlPanelState`.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "disarmed",
            "armed_home",
            "armed_away",
            "armed_night",
            "armed_vacation",
            "armed_custom_bypass",
            "disarming"
          ]
        },
        {
          "description": "Something tripped it, and it's counting down before it sounds.",
          "type": "string",
          "const": "pending"
        },
        {
          "description": "Told to arm, and counting down so people can leave.",
          "type": "string",
          "const": "arming"
        },
        {
          "description": "Going off.",
          "type": "string",
          "const": "triggered"
        }
      ]
    },
    "AttributeKey": {
      "description": "Format of a slug (attribute key): lowercase letters a-z and digits, in words separated by single `_`. 1-64 characters.",
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"
    },
    "CameraStatus": {
      "description": "What a camera is doing. Home Assistant's camera states, with `off` for one turned off.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "off",
            "idle",
            "recording"
          ]
        },
        {
          "description": "Someone is watching it live.",
          "type": "string",
          "const": "streaming"
        }
      ]
    },
    "CivilDate": {
      "type": "string",
      "examples": [
        "2026-10-14"
      ],
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$"
    },
    "ClockTime": {
      "type": "string",
      "examples": [
        "06:45:00"
      ],
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9](:[0-5][0-9])?$"
    },
    "ColorMode": {
      "type": "string",
      "enum": [
        "color_temp",
        "rgb"
      ]
    },
    "ContextId": {
      "description": "A ULID: 26 characters, uppercase Crockford base32.",
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "FanDirection": {
      "type": "string",
      "enum": [
        "forward",
        "reverse"
      ]
    },
    "HumidifierAction": {
      "description": "What it's doing right now.",
      "type": "string",
      "enum": [
        "off",
        "humidifying",
        "drying",
        "idle"
      ]
    },
    "HvacAction": {
      "description": "What it's doing right now, which can differ from its mode: set to heat, but idle because\nthe room is warm enough.",
      "type": "string",
      "enum": [
        "off",
        "preheating",
        "heating",
        "cooling",
        "drying",
        "idle",
        "fan",
        "defrosting"
      ]
    },
    "HvacMode": {
      "description": "What it's set to do: Home Assistant's modes.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "off",
            "heat",
            "cool",
            "dry",
            "fan_only"
          ]
        },
        {
          "description": "Heats or cools to stay within a range.",
          "type": "string",
          "const": "heat_cool"
        },
        {
          "description": "Follows its own schedule or logic.",
          "type": "string",
          "const": "auto"
        }
      ]
    },
    "LockStatus": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "locked",
            "unlocked",
            "locking",
            "unlocking",
            "open",
            "opening"
          ]
        },
        {
          "description": "Stuck: it tried and couldn't finish.",
          "type": "string",
          "const": "jammed"
        }
      ]
    },
    "MowerActivity": {
      "description": "What a mower is doing. Home Assistant's `LawnMowerActivity`.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "mowing",
            "docked",
            "paused"
          ]
        },
        {
          "description": "On its way back to the dock.",
          "type": "string",
          "const": "returning"
        },
        {
          "description": "Stuck, or something is wrong with it.",
          "type": "string",
          "const": "error"
        }
      ]
    },
    "OpenState": {
      "description": "Where something that opens and closes is: a cover's or a valve's.",
      "type": "string",
      "enum": [
        "open",
        "opening",
        "closed",
        "closing"
      ]
    },
    "Playback": {
      "description": "What it's doing. The primary value automations compare.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "playing",
            "paused",
            "buffering"
          ]
        },
        {
          "description": "Switched off, or the TV isn't showing this source.",
          "type": "string",
          "const": "off"
        },
        {
          "description": "On, with nothing playing. A backdrop counts as this.",
          "type": "string",
          "const": "idle"
        },
        {
          "description": "The TV is in standby. Only when the device says so.",
          "type": "string",
          "const": "standby"
        }
      ]
    },
    "SensorValue": {
      "description": "A sensor reading: a finite number or text, matching the sensor's `value_type`.",
      "anyOf": [
        {
          "type": "number",
          "maximum": 1.7976931348623157e+308,
          "minimum": -1.7976931348623157e+308
        },
        {
          "type": "string"
        }
      ]
    },
    "State": {
      "description": "A typed value, tagged with the entity kind it belongs to.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "brightness": {
              "description": "1-255, when the light supports dimming. Kept while off: the level it returns to.",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint8",
              "maximum": 255,
              "minimum": 1
            },
            "color_mode": {
              "description": "Which color setting is active, when the light supports more than one.",
              "anyOf": [
                {
                  "$ref": "#/$defs/ColorMode"
                },
                {
                  "type": "null"
                }
              ]
            },
            "color_temp_kelvin": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint16",
              "maximum": 20000,
              "minimum": 1000
            },
            "kind": {
              "type": "string",
              "const": "light"
            },
            "on": {
              "type": "boolean"
            },
            "rgb": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "integer",
                "format": "uint8",
                "maximum": 255,
                "minimum": 0
              },
              "maxItems": 3,
              "minItems": 3
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "on"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "switch"
            },
            "on": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "on"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "sensor"
            },
            "value": {
              "$ref": "#/$defs/SensorValue"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "binary_sensor"
            },
            "on": {
              "description": "`true` means detected/open/wet/etc., depending on the device class.",
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "on"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "number"
            },
            "value": {
              "type": "number",
              "format": "double"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "select"
            },
            "option": {
              "description": "The choice it's on: one of its options.",
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "option"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "text"
            },
            "value": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "event_type": {
              "description": "What happened last: one of its `event_types`.",
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "event"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "event_type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "cover"
            },
            "position": {
              "description": "0 (closed) to 100 (open), when it can say.",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint8",
              "maximum": 100,
              "minimum": 0
            },
            "state": {
              "$ref": "#/$defs/OpenState"
            },
            "tilt": {
              "description": "0 (closed) to 100 (open), for one whose slats tilt.",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint8",
              "maximum": 100,
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "lock"
            },
            "state": {
              "$ref": "#/$defs/LockStatus"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "direction": {
              "anyOf": [
                {
                  "$ref": "#/$defs/FanDirection"
                },
                {
                  "type": "null"
                }
              ]
            },
            "kind": {
              "type": "string",
              "const": "fan"
            },
            "on": {
              "type": "boolean"
            },
            "oscillating": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "percentage": {
              "description": "Its speed, 1-100, when it has speeds. Kept while off: the speed it comes back on at.",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint8",
              "maximum": 100,
              "minimum": 0
            },
            "preset_mode": {
              "description": "One of its `preset_modes`, when it's in one.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "on"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "valve"
            },
            "position": {
              "description": "0 (closed) to 100 (open), when it can say.",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint8",
              "maximum": 100,
              "minimum": 0
            },
            "state": {
              "$ref": "#/$defs/OpenState"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "siren"
            },
            "on": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "on"
          ]
        },
        {
          "type": "object",
          "properties": {
            "current_humidity": {
              "description": "In %.",
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "current_temperature": {
              "description": "The room's temperature, as it measures it, in °C.",
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "fan_mode": {
              "type": [
                "string",
                "null"
              ]
            },
            "hvac_action": {
              "anyOf": [
                {
                  "$ref": "#/$defs/HvacAction"
                },
                {
                  "type": "null"
                }
              ]
            },
            "hvac_mode": {
              "$ref": "#/$defs/HvacMode"
            },
            "kind": {
              "type": "string",
              "const": "climate"
            },
            "preset_mode": {
              "type": [
                "string",
                "null"
              ]
            },
            "swing_mode": {
              "type": [
                "string",
                "null"
              ]
            },
            "target_humidity": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "target_temp_high": {
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "target_temp_low": {
              "description": "In °C, for one that takes a range.",
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "target_temperature": {
              "description": "In °C, for one that takes a single target.",
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "hvac_mode"
          ]
        },
        {
          "type": "object",
          "properties": {
            "current_temperature": {
              "description": "The water's temperature, in °C.",
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "kind": {
              "type": "string",
              "const": "water_heater"
            },
            "operation_mode": {
              "$ref": "#/$defs/WaterHeaterMode"
            },
            "target_temperature": {
              "description": "In °C.",
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "operation_mode"
          ]
        },
        {
          "type": "object",
          "properties": {
            "action": {
              "anyOf": [
                {
                  "$ref": "#/$defs/HumidifierAction"
                },
                {
                  "type": "null"
                }
              ]
            },
            "current_humidity": {
              "description": "The room's humidity, as it measures it, in %.",
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "kind": {
              "type": "string",
              "const": "humidifier"
            },
            "mode": {
              "type": [
                "string",
                "null"
              ]
            },
            "on": {
              "type": "boolean"
            },
            "target_humidity": {
              "description": "In %.",
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "on"
          ]
        },
        {
          "type": "object",
          "properties": {
            "album": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 255,
              "minLength": 1
            },
            "app": {
              "description": "The app that's showing, when it says.",
              "type": [
                "string",
                "null"
              ],
              "maxLength": 255,
              "minLength": 1
            },
            "artist": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 255,
              "minLength": 1
            },
            "content_type": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 255,
              "minLength": 1
            },
            "duration": {
              "description": "How long the current media is, in seconds.",
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "kind": {
              "type": "string",
              "const": "media_player"
            },
            "muted": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "position": {
              "description": "Where playback is, in seconds, when it can seek.",
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "state": {
              "description": "What it's doing. Its typed value, for rules (`text()`).",
              "$ref": "#/$defs/Playback"
            },
            "title": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 255,
              "minLength": 1
            },
            "volume": {
              "description": "0–100, when volume can be set.",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint8",
              "maximum": 100,
              "minimum": 0
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "available": {
              "description": "A newer version than the installed one is there to install, and it isn't the skipped one.",
              "type": "boolean"
            },
            "in_progress": {
              "description": "An install is running.",
              "type": "boolean",
              "default": false
            },
            "installed_version": {
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "type": "string",
              "const": "update"
            },
            "last_error": {
              "description": "Why the last install didn't finish: the protocol's reason when it has one, otherwise the\ncore's. The next install clears it.",
              "type": [
                "string",
                "null"
              ]
            },
            "latest_version": {
              "type": [
                "string",
                "null"
              ]
            },
            "progress": {
              "description": "How far the install has got, in %, from a device that says.",
              "type": [
                "number",
                "null"
              ],
              "format": "double",
              "maximum": 100.0,
              "minimum": 0.0
            },
            "release_summary": {
              "description": "A few words on what the latest version changes.",
              "type": [
                "string",
                "null"
              ]
            },
            "release_url": {
              "description": "Where the full release notes are.",
              "type": [
                "string",
                "null"
              ]
            },
            "skipped_version": {
              "description": "The version someone chose to pass over. The core sets it; a protocol's is ignored.",
              "type": [
                "string",
                "null"
              ]
            },
            "title": {
              "description": "What the software is called, when that isn't the device's name.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "available"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "alarm_control_panel"
            },
            "state": {
              "$ref": "#/$defs/AlarmStatus"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "date"
            },
            "value": {
              "$ref": "#/$defs/CivilDate"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "time"
            },
            "value": {
              "$ref": "#/$defs/ClockTime"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "datetime"
            },
            "value": {
              "$ref": "#/$defs/Timestamp"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "activity": {
              "$ref": "#/$defs/VacuumActivity"
            },
            "fan_speed": {
              "description": "One of its `fan_speeds` (checked by the core).",
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "type": "string",
              "const": "vacuum"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "activity"
          ]
        },
        {
          "type": "object",
          "properties": {
            "activity": {
              "$ref": "#/$defs/MowerActivity"
            },
            "kind": {
              "type": "string",
              "const": "lawn_mower"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "activity"
          ]
