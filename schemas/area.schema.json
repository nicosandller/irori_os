{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Area",
  "description": "A room or zone.",
  "type": "object",
  "properties": {
    "floor_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/FloorId"
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "$ref": "#/$defs/AreaId"
    },
    "name": {
      "$ref": "#/$defs/Name"
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "name"
  ],
  "$defs": {
    "AreaId": {
      "description": "Format of a slug (area id): lowercase letters a-z and digits, in words separated by single `_`. 1-64 characters.",
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"
    },
    "FloorId": {
      "description": "Format of a slug (floor id): lowercase letters a-z and digits, in words separated by single `_`. 1-64 characters.",
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"
    },
    "Name": {
      "description": "A human-readable name. 1-100 characters, no leading or trailing whitespace.",
      "type": "string",
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[^\\u0020\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF\\u0000-\\u001F\\u007F-\\u009F]([^\\u0000-\\u001F\\u007F-\\u009F]*[^\\u0020\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF\\u0000-\\u001F\\u007F-\\u009F])?$"
    }
  }
}
