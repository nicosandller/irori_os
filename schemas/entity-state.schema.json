{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EntityState",
  "description": "The current state of one entity.",
  "type": "object",
  "properties": {
    "attributes": {
      "description": "Free-form extras from the integration, e.g. Zigbee link quality. Readable by rules but not type-checked.",
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/AttributeKey"
      }
    },
    "availability": {
      "description": "Whether the device is reachable. When `unavailable`, `state` keeps the last known value.",
      "$ref": "#/$defs/Availability"
    },
    "context": {
      "description": "What caused the last change.",
      "$ref": "#/$defs/Context"
    },
    "entity_id": {
      "description": "Its kind must match `state.kind`.",
      "$ref": "#/$defs/EntityId"
    },
    "last_changed": {
      "description": "When `state` or `availability` last changed.",
      "$ref": "#/$defs/Timestamp"
    },
    "last_reported": {
      "description": "When the integration last reported anything, even an identical value.",
      "$ref": "#/$defs/Timestamp"
    },
    "last_updated": {
      "description": "When `state`, `availability`, or `attributes` last changed.",
      "$ref": "#/$defs/Timestamp"
    },
    "state": {
      "description": "The typed value, or `null` if the entity has never reported one (\"unknown\"). Must be\npresent even when `null`, so a producer can't mark an entity unknown by forgetting it.",
      "anyOf": [
        {
          "$ref": "#/$defs/State"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "entity_id": {
            "pattern": "^light\\."
          }
        },
        "required": [
          "entity_id"
        ]
      },
      "then": {
        "properties": {
          "state": {
            "properties": {
              "kind": {
                "const": "light"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "entity_id": {
            "pattern": "^switch\\."
          }
        },
        "required": [
          "entity_id"
        ]
      },
      "then": {
        "properties": {
          "state": {
            "properties": {
              "kind": {
                "const": "switch"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "entity_id": {
            "pattern": "^sensor\\."
          }
        },
        "required": [
          "entity_id"
        ]
      },
      "then": {
        "properties": {
          "state": {
            "properties": {
              "kind": {
                "const": "sensor"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "entity_id": {
            "pattern": "^binary_sensor\\."
          }
        },
        "required": [
          "entity_id"
        ]
      },
      "then": {
        "properties": {
          "state": {
            "properties": {
              "kind": {
                "const": "binary_sensor"
              }
            }
          }
        }
      }
    }
  ],
  "required": [
    "entity_id",
    "availability",
    "last_changed",
    "last_updated",
    "last_reported",
    "context",
    "state"
  ],
  "$defs": {
    "AttributeKey": {
      "description": "Format of a slug (attribute key): lowercase letters a-z and digits, in words separated by single `_`. 1-64 characters.",
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"
    },
    "Availability": {
      "type": "string",
      "enum": [
        "available",
        "unavailable"
      ]
    },
    "ColorMode": {
      "type": "string",
      "enum": [
        "color_temp",
        "rgb"
      ]
    },
    "Context": {
      "description": "Why something happened. Every state change and service call carries one, so any change can\nbe traced back to its cause (`docs/specs/entities.md` §6).",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/ContextId"
        },
        "origin": {
          "$ref": "#/$defs/Origin"
        },
        "parent_id": {
          "description": "The context that caused this one, e.g. the motion event that triggered a rule run.",
          "anyOf": [
            {
              "$ref": "#/$defs/ContextId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "origin"
      ]
    },
    "ContextId": {
      "description": "A ULID: 26 characters, uppercase Crockford base32.",
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "EntityId": {
      "description": "An entity id: `<kind>.<object_id>`, e.g. `light.hallway`. The object id uses lowercase letters a-z and digits in words separated by single `_`, 1-64 characters.",
      "type": "string",
      "maxLength": 78,
      "pattern": "^(light|switch|sensor|binary_sensor)\\.[a-z0-9]+(_[a-z0-9]+)*$"
    },
    "IntegrationId": {
      "description": "Format of a slug (integration id): lowercase letters a-z and digits, in words separated by single `_`. 1-64 characters.",
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"
    },
    "Origin": {
      "description": "Where a context started.",
      "oneOf": [
        {
          "description": "Reported by a device through an integration, e.g. someone pressed a physical switch.",
          "type": "object",
          "properties": {
            "integration": {
              "$ref": "#/$defs/IntegrationId"
            },
            "type": {
              "type": "string",
              "const": "device"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "integration"
          ]
        },
        {
          "description": "A person, through the UI or CLI.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "user"
            },
            "user_id": {
              "$ref": "#/$defs/UserId"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "user_id"
          ]
        },
        {
          "description": "A rule run.",
          "type": "object",
          "properties": {
            "rule_id": {
              "$ref": "#/$defs/RuleId"
            },
            "run_id": {
              "$ref": "#/$defs/ContextId"
            },
            "type": {
              "type": "string",
              "const": "rule"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "rule_id",
            "run_id"
          ]
        },
        {
          "description": "An API client authenticated with an access token.",
          "type": "object",
          "properties": {
            "token_id": {
              "$ref": "#/$defs/TokenId"
            },
            "type": {
              "type": "string",
              "const": "api"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "token_id"
          ]
        },
        {
          "description": "Irori itself, e.g. restoring state at startup or reloading config.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "system"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        }
      ]
    },
    "RuleId": {
      "description": "Format of a slug (rule id): lowercase letters a-z and digits, in words separated by single `_`. 1-64 characters.",
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"
    },
    "SensorValue": {
      "description": "A sensor reading: a finite number or text, matching the sensor's `value_type`.",
      "anyOf": [
        {
          "type": "number",
          "format": "double"
        },
        {
          "type": "string"
        }
      ]
    },
    "State": {
      "description": "A typed value, tagged with the entity kind it belongs to.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "brightness": {
              "description": "1-255, when the light supports dimming. Kept while off: the level it returns to.",
              "type": [
                "integer",
                "null"
              ],
              "format": "uint8",
              "maximum": 255,
              "minimum": 1
            },
            "color_mode": {
              "description": "Which color setting is active, when the light supports more than one.",
              "anyOf": [
                {
                  "$ref": "#/$defs/ColorMode"
                },
                {
                  "type": "null"
                }
              ]
            },
            "color_temp_kelvin": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint16",
              "maximum": 20000,
              "minimum": 1000
            },
            "kind": {
              "type": "string",
              "const": "light"
            },
            "on": {
              "type": "boolean"
            },
            "rgb": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "type": "integer",
                "format": "uint8",
                "maximum": 255,
                "minimum": 0
              },
              "maxItems": 3,
              "minItems": 3
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "on"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "switch"
            },
            "on": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "on"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "sensor"
            },
            "value": {
              "$ref": "#/$defs/SensorValue"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "binary_sensor"
            },
            "on": {
              "description": "`true` means detected/open/wet/etc., depending on the device class.",
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "on"
          ]
        }
      ]
    },
    "Timestamp": {
      "description": "RFC 3339 timestamp with an offset, e.g. 2026-09-15T22:04:31.120Z. Uppercase T and Z, at most 9 fractional digits, offset -23:59 to +23:59. Serialized in UTC.",
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])T([01][0-9]|2[0-3]):[0-5][0-9]:([0-5][0-9]|60)(\\.[0-9]{1,9})?(Z|[+-]([01][0-9]|2[0-3]):[0-5][0-9])$"
    },
    "TokenId": {
      "description": "Format of a slug (token id): lowercase letters a-z and digits, in words separated by single `_`. 1-64 characters.",
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"
    },
    "UserId": {
      "description": "Format of a slug (user id): lowercase letters a-z and digits, in words separated by single `_`. 1-64 characters.",
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"
    }
  }
}
