{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rule",
  "description": "One rule, as stored in `rules/<id>.json`.",
  "type": "object",
  "properties": {
    "actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Action"
      },
      "maxItems": 64,
      "minItems": 1
    },
    "conditions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Condition"
      },
      "maxItems": 32
    },
    "description": {
      "anyOf": [
        {
          "$ref": "#/$defs/Description"
        },
        {
          "type": "null"
        }
      ]
    },
    "enabled": {
      "type": "boolean"
    },
    "id": {
      "$ref": "#/$defs/RuleId"
    },
    "mode": {
      "$ref": "#/$defs/Mode"
    },
    "name": {
      "$ref": "#/$defs/Name"
    },
    "triggers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Trigger"
      },
      "maxItems": 16,
      "minItems": 1
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "triggers",
    "actions"
  ],
  "$defs": {
    "Action": {
      "description": "One step of a run.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "data": {
              "anyOf": [
                {
                  "$ref": "#/$defs/CallData"
                },
                {
                  "type": "null"
                }
              ]
            },
            "on_error": {
              "$ref": "#/$defs/OnError"
            },
            "service": {
              "$ref": "#/$defs/RuleService"
            },
            "target": {
              "$ref": "#/$defs/Target"
            },
            "type": {
              "type": "string",
              "const": "call"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "service",
            "target"
          ]
        },
        {
          "type": "object",
          "properties": {
            "for": {
              "$ref": "#/$defs/CompactDuration"
            },
            "type": {
              "type": "string",
              "const": "delay"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "for"
          ]
        },
        {
          "type": "object",
          "properties": {
            "on_timeout": {
              "$ref": "#/$defs/OnTimeout"
            },
            "timeout": {
              "$ref": "#/$defs/CompactDuration"
            },
            "type": {
              "type": "string",
              "const": "wait"
            },
            "until": {
              "$ref": "#/$defs/WaitUntil"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "until",
            "timeout"
          ]
        },
        {
          "type": "object",
          "properties": {
            "conditions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Condition"
              }
            },
            "else": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Action"
              }
            },
            "then": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Action"
              }
            },
            "type": {
              "type": "string",
              "const": "if"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "conditions",
            "then"
          ]
        },
        {
          "type": "object",
          "properties": {
            "default": {
              "description": "JSON name is `default`; the Rust field isn't, so JSON Schema doesn't treat it as\nthe `default` keyword.",
              "type": "array",
              "items": {
                "$ref": "#/$defs/Action"
              }
            },
            "options": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ChooseOption"
              }
            },
            "type": {
              "type": "string",
              "const": "choose"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "options"
          ]
        },
        {
          "type": "object",
          "properties": {
            "expr": {
              "$ref": "#/$defs/ExprString"
            },
            "name": {
              "$ref": "#/$defs/ObjectId"
            },
            "on_error": {
              "$ref": "#/$defs/OnError"
            },
            "type": {
              "type": "string",
              "const": "set"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "name",
            "expr"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "patternProperties": {
                "^[a-z0-9]+(_[a-z0-9]+)*$": {
                  "$ref": "#/$defs/EventDatum"
                }
              }
            },
            "event": {
              "$ref": "#/$defs/EventName"
            },
            "type": {
              "type": "string",
              "const": "event"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "event"
          ]
        },
        {
          "type": "object",
          "properties": {
            "reason": {
              "anyOf": [
                {
                  "$ref": "#/$defs/StopReason"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "stop"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        }
      ]
    },
    "AvailabilityWanted": {
      "type": "string",
      "enum": [
        "available",
        "unavailable"
      ]
    },
    "CallData": {
      "description": "Closed `data` object for a call. Unknown keys are rejected by the inner structs.",
      "anyOf": [
        {
          "$ref": "#/$defs/LightCallData"
        }
      ]
    },
    "ChooseOption": {
      "type": "object",
      "properties": {
        "conditions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Condition"
          }
        },
        "then": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Action"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "conditions",
        "then"
      ]
    },
    "CivilTime": {
      "description": "Civil time of day, HH:MM or HH:MM:SS.",
      "type": "string",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9](:[0-5][0-9])?$"
    },
    "CompactDuration": {
      "description": "Compact elapsed duration, e.g. 2m, 10m, 1h30m, 500ms, -30m.",
      "type": "string",
      "minLength": 2,
      "pattern": "^[+-]?([0-9]+d)?([0-9]+h)?([0-9]+m)?([0-9]+s)?([0-9]+ms)?$"
    },
    "Condition": {
      "description": "A level check. The top-level array is an implicit `all`.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "availability": {
              "anyOf": [
                {
                  "$ref": "#/$defs/AvailabilityWanted"
                },
                {
                  "type": "null"
                }
              ]
            },
            "entity": {
              "$ref": "#/$defs/EntityId"
            },
            "is": {
              "anyOf": [
                {
                  "$ref": "#/$defs/TypedValue"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "state"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "entity"
          ]
        },
        {
          "type": "object",
          "properties": {
            "expr": {
              "$ref": "#/$defs/ExprString"
            },
            "type": {
              "type": "string",
              "const": "expr"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "expr"
          ]
        },
        {
          "type": "object",
          "properties": {
            "after": {
              "anyOf": [
                {
                  "$ref": "#/$defs/CivilTime"
                },
                {
                  "type": "null"
                }
              ]
            },
            "before": {
              "anyOf": [
                {
                  "$ref": "#/$defs/CivilTime"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "time"
            },
            "weekday": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "$ref": "#/$defs/Weekday"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "after": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SunEvent"
                },
                {
                  "type": "null"
                }
              ]
            },
            "before": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SunEvent"
                },
                {
                  "type": "null"
                }
              ]
            },
            "offset": {
              "anyOf": [
                {
                  "$ref": "#/$defs/CompactDuration"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "sun"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "conditions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Condition"
              }
            },
            "type": {
              "type": "string",
              "const": "all"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "conditions"
          ]
        },
        {
          "type": "object",
          "properties": {
            "conditions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Condition"
              }
            },
            "type": {
              "type": "string",
              "const": "any"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "conditions"
          ]
        },
        {
          "type": "object",
          "properties": {
            "condition": {
              "$ref": "#/$defs/Condition"
            },
            "type": {
              "type": "string",
              "const": "not"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "condition"
          ]
        }
      ]
    },
    "Cron": {
      "description": "5-field cron: `minute hour day-of-month month day-of-week`.",
      "type": "string"
    },
    "Description": {
      "description": "A short description. 1-500 characters on one line, no leading or trailing whitespace.",
      "type": "string",
      "maxLength": 500,
      "minLength": 1,
      "pattern": "^[^\\u0020\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029]([^\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029]*[^\\u0020\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029])?$"
    },
    "EntityId": {
      "description": "An entity id: `<kind>.<object_id>`, e.g. `light.hallway`. The object id uses lowercase letters a-z and digits in words separated by single `_`, 1-64 characters.",
      "type": "string",
      "anyOf": [
        {
          "maxLength": 70,
          "pattern": "^light\\.[a-z0-9]+(_[a-z0-9]+)*$"
        },
        {
          "maxLength": 71,
          "pattern": "^switch\\.[a-z0-9]+(_[a-z0-9]+)*$"
        },
        {
          "maxLength": 71,
          "pattern": "^sensor\\.[a-z0-9]+(_[a-z0-9]+)*$"
        },
        {
          "maxLength": 78,
          "pattern": "^binary_sensor\\.[a-z0-9]+(_[a-z0-9]+)*$"
        }
      ]
    },
    "EventDatum": {
      "description": "Event data values are bool, number, or string.",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ]
    },
    "EventName": {
      "description": "Slug, or `integration.event` (one dot).",
      "type": "string"
    },
    "ExprString": {
      "description": "A CEL expression using the Irori function surface (num, on, available, …).",
      "type": "string",
      "maxLength": 512,
      "minLength": 1
    },
    "LightCallData": {
      "type": "object",
      "properties": {
        "brightness": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint8",
          "maximum": 255,
          "minimum": 1
        },
        "brightness_pct": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint8",
          "maximum": 100,
          "minimum": 1
        },
        "color_temp_kelvin": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "maximum": 20000,
          "minimum": 1000
        },
        "rgb": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "format": "uint8",
            "maximum": 255,
            "minimum": 0
          },
          "maxItems": 3,
          "minItems": 3
        }
      },
      "additionalProperties": false
    },
    "LimitedMode": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "max": {
              "type": "integer",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "queued"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "max"
          ]
        },
        {
          "type": "object",
          "properties": {
            "max": {
              "type": "integer",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "parallel"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "max"
          ]
        }
      ]
    },
    "Mode": {
      "description": "How a second trigger is handled while a run is in progress.",
      "anyOf": [
        {
          "$ref": "#/$defs/NamedMode"
        },
        {
          "$ref": "#/$defs/LimitedMode"
        }
      ]
    },
    "Name": {
      "description": "A human-readable name. 1-100 characters, no leading or trailing whitespace.",
      "type": "string",
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[^\\u0020\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF\\u0000-\\u001F\\u007F-\\u009F]([^\\u0000-\\u001F\\u007F-\\u009F]*[^\\u0020\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF\\u0000-\\u001F\\u007F-\\u009F])?$"
    },
    "NamedMode": {
      "type": "string",
      "enum": [
        "single",
        "restart"
      ]
    },
    "ObjectId": {
      "description": "Format of a slug (object id): lowercase letters a-z and digits, in words separated by single `_`. 1-64 characters.",
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"
    },
    "OnError": {
      "type": "string",
      "enum": [
        "stop",
        "continue"
      ]
    },
    "OnTimeout": {
      "type": "string",
      "enum": [
        "continue",
        "stop"
      ]
    },
    "RuleId": {
      "description": "Format of a slug (rule id): lowercase letters a-z and digits, in words separated by single `_`. 1-64 characters.",
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"
    },
    "RuleService": {
      "description": "Services a rule may name. Includes `toggle`, which the core resolves.",
      "type": "string",
      "enum": [
        "light.turn_on",
        "light.turn_off",
        "light.toggle",
        "switch.turn_on",
        "switch.turn_off",
        "switch.toggle"
      ]
    },
    "StopReason": {
      "description": "Optional reason stored on a stop action's trace.",
      "type": "string",
      "maxLength": 200,
      "minLength": 1
    },
    "SunEvent": {
      "type": "string",
      "enum": [
        "sunrise",
        "sunset",
        "dawn",
        "dusk",
        "noon",
        "midnight"
      ]
    },
    "Target": {
      "type": "object",
      "properties": {
        "entity": {
          "$ref": "#/$defs/EntityId"
        }
      },
      "additionalProperties": false,
      "required": [
        "entity"
      ]
    },
    "Trigger": {
      "description": "An edge that starts a run.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "entity": {
              "$ref": "#/$defs/EntityId"
            },
            "for": {
              "anyOf": [
                {
                  "$ref": "#/$defs/CompactDuration"
                },
                {
                  "type": "null"
                }
              ]
            },
            "from": {
              "anyOf": [
                {
                  "$ref": "#/$defs/TypedValue"
                },
                {
                  "type": "null"
                }
              ]
            },
            "to": {
              "anyOf": [
                {
                  "$ref": "#/$defs/TypedValue"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "state"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "entity"
          ]
        },
        {
          "type": "object",
          "properties": {
            "at": {
              "anyOf": [
                {
                  "$ref": "#/$defs/CivilTime"
                },
                {
                  "type": "null"
                }
              ]
            },
            "cron": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Cron"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "time"
            },
            "weekday": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "$ref": "#/$defs/Weekday"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "$ref": "#/$defs/SunEvent"
            },
            "offset": {
              "anyOf": [
                {
                  "$ref": "#/$defs/CompactDuration"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "sun"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "event"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "patternProperties": {
                "^[a-z0-9]+(_[a-z0-9]+)*$": {
                  "$ref": "#/$defs/EventDatum"
                }
              }
            },
            "event": {
              "$ref": "#/$defs/EventName"
            },
            "type": {
              "type": "string",
              "const": "event"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "event"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "startup"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        }
      ]
    },
    "TypedValue": {
      "description": "A typed state value: bool, finite number, string, or null (unknown).",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "WaitUntil": {
      "description": "Level matcher for a wait: `state` or `expr`, never a trigger `to`.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "availability": {
              "anyOf": [
                {
                  "$ref": "#/$defs/AvailabilityWanted"
                },
                {
                  "type": "null"
                }
              ]
            },
            "entity": {
              "$ref": "#/$defs/EntityId"
            },
            "for": {
              "anyOf": [
                {
                  "$ref": "#/$defs/CompactDuration"
                },
                {
                  "type": "null"
                }
              ]
            },
            "is": {
              "anyOf": [
                {
                  "$ref": "#/$defs/TypedValue"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "state"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "entity"
          ]
        },
        {
          "type": "object",
          "properties": {
            "expr": {
              "$ref": "#/$defs/ExprString"
            },
            "for": {
              "anyOf": [
                {
                  "$ref": "#/$defs/CompactDuration"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "expr"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "expr"
          ]
        }
      ]
    },
    "Weekday": {
      "type": "string",
      "enum": [
        "mon",
        "tue",
        "wed",
        "thu",
        "fri",
        "sat",
        "sun"
      ]
    }
  }
}
