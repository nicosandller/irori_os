      "description": "What it's set to do: Home Assistant's modes.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "off",
            "heat",
            "cool",
            "dry",
            "fan_only"
          ]
        },
        {
          "description": "Heats or cools to stay within a range.",
          "type": "string",
          "const": "heat_cool"
        },
        {
          "description": "Follows its own schedule or logic.",
          "type": "string",
          "const": "auto"
        }
      ]
    },
    "LightTurnOn": {
      "description": "Data for `light.turn_on`. Everything is optional: with no data, the light turns on at its\nlast brightness and color.",
      "type": "object",
      "properties": {
        "brightness": {
          "description": "1-255. Needs a dimmable light.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint8",
          "maximum": 255,
          "minimum": 1
        },
        "color_temp_kelvin": {
          "description": "Needs color temperature support, within the light's range. Not together with `rgb`.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "maximum": 20000,
          "minimum": 1000
        },
        "rgb": {
          "description": "Needs RGB support. Not together with `color_temp_kelvin`.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "format": "uint8",
            "maximum": 255,
            "minimum": 0
          },
          "maxItems": 3,
          "minItems": 3
        }
      },
      "additionalProperties": false,
      "not": {
        "properties": {
          "color_temp_kelvin": {
            "type": "integer"
          },
          "rgb": {
            "type": "array"
          }
        },
        "required": [
          "color_temp_kelvin",
          "rgb"
        ]
      }
    },
