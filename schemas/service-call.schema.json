            {
              "$ref": "#/$defs/ContextId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "origin"
      ]
    },
    "ContextId": {
      "description": "A ULID: 26 characters, uppercase Crockford base32.",
      "type": "string",
      "pattern": "^[0-7][0-9A-HJKMNP-TV-Z]{25}$"
    },
    "ExtensionId": {
      "description": "Format of a slug (extension id): lowercase letters a-z and digits, in words separated by single `_`. 1-64 characters.",
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"
