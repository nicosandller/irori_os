{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Flow",
  "description": "One flow, as stored in `flows/<id>.json`.",
  "type": "object",
  "properties": {
    "description": {
      "anyOf": [
        {
          "$ref": "#/$defs/Description"
        },
        {
          "type": "null"
        }
      ]
    },
    "enabled": {
      "description": "Off keeps the file and its history, but nothing runs. Not part of the version.",
      "type": "boolean"
    },
    "groups": {
      "description": "Names given to the canvas's branches, by the node each one starts at: a branch by its\nfirst trigger, a part of one by its first node. Not part of the version.",
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z0-9]+(_[a-z0-9]+)*$": {
          "$ref": "#/$defs/Name"
        }
      }
    },
    "id": {
      "$ref": "#/$defs/RuleId"
    },
    "layout": {
      "description": "Where each node sits on the canvas. Not part of the version.",
      "type": "object",
      "additionalProperties": false,
      "patternProperties": {
        "^[a-z0-9]+(_[a-z0-9]+)*$": {
          "type": "array",
          "items": {
            "type": "number",
            "format": "double"
          },
          "maxItems": 2,
          "minItems": 2
        }
      }
    },
    "mode": {
      "description": "What happens when a trigger fires while a run is going.",
      "$ref": "#/$defs/Mode"
    },
    "name": {
      "$ref": "#/$defs/Name"
    },
    "nodes": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 128,
      "minProperties": 1,
      "patternProperties": {
        "^[a-z0-9]+(_[a-z0-9]+)*$": {
          "$ref": "#/$defs/Node"
        }
      }
    },
    "wires": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Wire"
      },
      "maxItems": 512
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "nodes"
  ],
  "$defs": {
    "Amount": {
      "description": "A number in a call's settings: fixed, or worked out when the call runs.",
      "anyOf": [
        {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        {
          "$ref": "#/$defs/Worked"
        }
      ]
    },
    "Amount2": {
      "description": "A number in a call's settings: fixed, or worked out when the call runs.",
      "anyOf": [
        {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        {
          "$ref": "#/$defs/Worked"
        }
      ]
    },
    "AvailabilityWanted": {
      "type": "string",
      "enum": [
        "available",
        "unavailable"
      ]
    },
    "CivilTime": {
      "description": "Civil time of day, HH:MM or HH:MM:SS.",
      "type": "string",
      "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9](:[0-5][0-9])?$"
    },
    "CompactDuration": {
      "description": "Compact elapsed duration, e.g. 2m, 10m, 1h30m, 500ms, -30m.",
      "type": "string",
      "minLength": 2,
      "pattern": "^[+-]?([0-9]+d)?([0-9]+h)?([0-9]+m)?([0-9]+s)?([0-9]+ms)?$"
    },
    "Condition": {
      "description": "A level check. The top-level array is an implicit `all`.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "availability": {
              "anyOf": [
                {
                  "$ref": "#/$defs/AvailabilityWanted"
                },
                {
                  "type": "null"
                }
              ]
            },
            "entity": {
              "$ref": "#/$defs/EntityId"
            },
            "is": {
              "anyOf": [
                {
                  "$ref": "#/$defs/TypedValue"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "state"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "entity"
          ]
        },
        {
          "type": "object",
          "properties": {
            "expr": {
              "$ref": "#/$defs/ExprString"
            },
            "type": {
              "type": "string",
              "const": "expr"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "expr"
          ]
        },
        {
          "type": "object",
          "properties": {
            "after": {
              "anyOf": [
                {
                  "$ref": "#/$defs/CivilTime"
                },
                {
                  "type": "null"
                }
              ]
            },
            "before": {
              "anyOf": [
                {
                  "$ref": "#/$defs/CivilTime"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "time"
            },
            "weekday": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "$ref": "#/$defs/Weekday"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "after": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SunEvent"
                },
                {
                  "type": "null"
                }
              ]
            },
            "before": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SunEvent"
                },
                {
                  "type": "null"
                }
              ]
            },
            "offset": {
              "anyOf": [
                {
                  "$ref": "#/$defs/CompactDuration"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "sun"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "conditions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Condition"
              }
            },
            "type": {
              "type": "string",
              "const": "all"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "conditions"
          ]
        },
        {
          "type": "object",
          "properties": {
            "conditions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Condition"
              }
            },
            "type": {
              "type": "string",
              "const": "any"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "conditions"
          ]
        },
        {
          "type": "object",
          "properties": {
            "condition": {
              "$ref": "#/$defs/Condition"
            },
            "type": {
              "type": "string",
              "const": "not"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "condition"
          ]
        }
      ]
    },
    "Cron": {
      "description": "5-field cron: `minute hour day-of-month month day-of-week`.",
      "type": "string"
    },
    "Description": {
      "description": "A short description. 1-500 characters on one line, no leading or trailing whitespace.",
      "type": "string",
      "maxLength": 500,
      "minLength": 1,
      "pattern": "^[^\\u0020\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029]([^\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029]*[^\\u0020\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029])?$"
    },
    "EntityId": {
      "description": "An entity id: `<kind>.<object_id>`, e.g. `light.hallway`. The object id uses lowercase letters a-z and digits in words separated by single `_`, 1-64 characters.",
      "type": "string",
      "anyOf": [
        {
          "maxLength": 70,
          "pattern": "^light\\.[a-z0-9]+(_[a-z0-9]+)*$"
        },
        {
          "maxLength": 71,
          "pattern": "^switch\\.[a-z0-9]+(_[a-z0-9]+)*$"
        },
        {
          "maxLength": 71,
          "pattern": "^sensor\\.[a-z0-9]+(_[a-z0-9]+)*$"
        },
        {
          "maxLength": 78,
          "pattern": "^binary_sensor\\.[a-z0-9]+(_[a-z0-9]+)*$"
        },
        {
          "maxLength": 71,
          "pattern": "^number\\.[a-z0-9]+(_[a-z0-9]+)*$"
        },
        {
          "maxLength": 71,
          "pattern": "^select\\.[a-z0-9]+(_[a-z0-9]+)*$"
        },
        {
          "maxLength": 69,
          "pattern": "^text\\.[a-z0-9]+(_[a-z0-9]+)*$"
        },
        {
          "maxLength": 71,
          "pattern": "^button\\.[a-z0-9]+(_[a-z0-9]+)*$"
        },
        {
          "maxLength": 70,
          "pattern": "^event\\.[a-z0-9]+(_[a-z0-9]+)*$"
        },
        {
          "maxLength": 70,
          "pattern": "^cover\\.[a-z0-9]+(_[a-z0-9]+)*$"
        },
        {
          "maxLength": 69,
          "pattern": "^lock\\.[a-z0-9]+(_[a-z0-9]+)*$"
        },
        {
          "maxLength": 68,
          "pattern": "^fan\\.[a-z0-9]+(_[a-z0-9]+)*$"
        },
        {
          "maxLength": 70,
          "pattern": "^valve\\.[a-z0-9]+(_[a-z0-9]+)*$"
        }
      ]
    },
    "EventDatum": {
      "description": "Event data values are bool, number, or string.",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        }
      ]
    },
    "EventName": {
      "description": "Slug, or `protocol.event` (one dot).",
      "type": "string"
    },
    "ExprString": {
      "description": "A CEL expression using the Irori function surface (num, on, available, …).",
      "type": "string",
      "maxLength": 512,
      "minLength": 1
    },
    "FlowCallData": {
      "description": "A light's settings in a call: each number either written down, or worked out from an\nexpression when the call runs (`{\"expr\": \"var('level')\"}`), rounded and brought into range.",
      "type": "object",
      "properties": {
        "brightness": {
          "anyOf": [
            {
              "$ref": "#/$defs/Amount"
            },
            {
              "type": "null"
            }
          ]
        },
        "brightness_pct": {
          "anyOf": [
            {
              "$ref": "#/$defs/Amount"
            },
            {
              "type": "null"
            }
          ]
        },
        "color_temp_kelvin": {
          "anyOf": [
            {
              "$ref": "#/$defs/Amount2"
            },
            {
              "type": "null"
            }
          ]
        },
        "rgb": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "integer",
            "format": "uint8",
            "maximum": 255,
            "minimum": 0
          },
          "maxItems": 3,
          "minItems": 3
        }
      },
      "additionalProperties": false
    },
    "JoinMode": {
      "description": "How a join brings paths together.",
      "oneOf": [
        {
          "description": "Wait until every incoming wire has brought a token.",
          "type": "string",
          "const": "all"
        },
        {
          "description": "Let the first through; the rest end here.",
          "type": "string",
          "const": "first"
        }
      ]
    },
    "LimitedMode": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "max": {
              "type": "integer",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "queued"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "max"
          ]
        },
        {
          "type": "object",
          "properties": {
            "max": {
              "type": "integer",
              "format": "uint8",
              "maximum": 255,
              "minimum": 0
            },
            "type": {
              "type": "string",
              "const": "parallel"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "max"
          ]
        }
      ]
    },
    "Mode": {
      "description": "How a second trigger is handled while a run is in progress.",
      "anyOf": [
        {
          "$ref": "#/$defs/NamedMode"
        },
        {
          "$ref": "#/$defs/LimitedMode"
        }
      ]
    },
    "Name": {
      "description": "A human-readable name. 1-100 characters, no leading or trailing whitespace.",
      "type": "string",
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[^\\u0020\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF\\u0000-\\u001F\\u007F-\\u009F]([^\\u0000-\\u001F\\u007F-\\u009F]*[^\\u0020\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF\\u0000-\\u001F\\u007F-\\u009F])?$"
    },
    "NamedMode": {
      "type": "string",
      "enum": [
        "single",
        "restart"
      ]
    },
    "Node": {
      "description": "One step of a flow.",
      "oneOf": [
        {
          "description": "Starts a run.",
          "type": "object",
          "properties": {
            "trigger": {
              "$ref": "#/$defs/Trigger"
            },
            "type": {
              "type": "string",
              "const": "trigger"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "trigger"
          ]
        },
        {
          "description": "Checks once: `yes` or `no`.",
          "type": "object",
          "properties": {
            "condition": {
              "$ref": "#/$defs/Condition"
            },
            "type": {
              "type": "string",
              "const": "gate"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "condition"
          ]
        },
        {
          "description": "The first case that holds, or `else`.",
          "type": "object",
          "properties": {
            "cases": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Condition"
              },
              "maxItems": 16,
              "minItems": 1
            },
            "type": {
              "type": "string",
              "const": "switch"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "cases"
          ]
        },
        {
          "description": "Calls a service: `out`, or `error` if it failed.",
          "type": "object",
          "properties": {
            "data": {
              "anyOf": [
                {
                  "$ref": "#/$defs/FlowCallData"
                },
                {
                  "type": "null"
                }
              ]
            },
            "entity": {
              "$ref": "#/$defs/EntityId"
            },
            "service": {
              "$ref": "#/$defs/RuleService"
            },
            "type": {
              "type": "string",
              "const": "call"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "service",
            "entity"
          ]
        },
        {
          "description": "Sets a run variable, read with `var('name')`.",
          "type": "object",
          "properties": {
            "expr": {
              "$ref": "#/$defs/ExprString"
            },
            "name": {
              "$ref": "#/$defs/ObjectId"
            },
            "type": {
              "type": "string",
              "const": "set"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "name",
            "expr"
          ]
        },
        {
          "description": "Waits this long.",
          "type": "object",
          "properties": {
            "for": {
              "$ref": "#/$defs/CompactDuration"
            },
            "type": {
              "type": "string",
              "const": "delay"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "for"
          ]
        },
        {
          "description": "Waits for a level to hold: `matched`, or `timeout`.",
          "type": "object",
          "properties": {
            "timeout": {
              "$ref": "#/$defs/CompactDuration"
            },
            "type": {
              "type": "string",
              "const": "wait"
            },
            "until": {
              "$ref": "#/$defs/WaitUntil"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "until",
            "timeout"
          ]
        },
        {
          "description": "Brings paths of one run back together.",
          "type": "object",
          "properties": {
            "mode": {
              "$ref": "#/$defs/JoinMode"
            },
            "timeout": {
              "anyOf": [
                {
                  "$ref": "#/$defs/CompactDuration"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "join"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "mode"
          ]
        },
        {
          "description": "Ends the whole run.",
          "type": "object",
          "properties": {
            "reason": {
              "anyOf": [
                {
                  "$ref": "#/$defs/StopReason"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "stop"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        }
      ]
    },
    "ObjectId": {
      "description": "Format of a slug (object id): lowercase letters a-z and digits, in words separated by single `_`. 1-64 characters.",
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"
    },
    "RuleId": {
      "description": "Format of a slug (rule id): lowercase letters a-z and digits, in words separated by single `_`. 1-64 characters.",
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"
    },
    "RuleService": {
      "description": "Services a rule may name. Includes `toggle`, which the core resolves.",
      "type": "string",
      "enum": [
        "light.turn_on",
        "light.turn_off",
        "light.toggle",
        "switch.turn_on",
        "switch.turn_off",
        "switch.toggle"
      ]
    },
    "StopReason": {
      "description": "Optional reason stored on a stop action's trace.",
      "type": "string",
      "maxLength": 200,
      "minLength": 1
    },
    "SunEvent": {
      "type": "string",
      "enum": [
        "sunrise",
        "sunset",
        "dawn",
        "dusk",
        "noon",
        "midnight"
      ]
    },
    "Trigger": {
      "description": "An edge that starts a run.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "above": {
              "description": "For a sensor with numbers: fires when its reading goes above this (and below\n`below`, if that's given too) from outside that range. Not with `from`/`to`.",
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "below": {
              "description": "For a sensor with numbers: fires when its reading goes below this from outside the\nrange. Not with `from`/`to`.",
              "type": [
                "number",
                "null"
              ],
              "format": "double"
            },
            "entity": {
              "$ref": "#/$defs/EntityId"
            },
            "for": {
              "anyOf": [
                {
                  "$ref": "#/$defs/CompactDuration"
                },
                {
                  "type": "null"
                }
              ]
            },
            "from": {
              "anyOf": [
                {
                  "$ref": "#/$defs/TypedValue"
                },
                {
                  "type": "null"
                }
              ]
            },
            "to": {
              "description": "The value it changes to, or any one of several.",
              "anyOf": [
                {
                  "$ref": "#/$defs/Values"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "state"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "entity"
          ]
        },
        {
          "type": "object",
          "properties": {
            "at": {
              "anyOf": [
                {
                  "$ref": "#/$defs/CivilTime"
                },
                {
                  "type": "null"
                }
              ]
            },
            "cron": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Cron"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "time"
            },
            "weekday": {
              "type": [
                "array",
                "null"
              ],
              "items": {
                "$ref": "#/$defs/Weekday"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "event": {
              "$ref": "#/$defs/SunEvent"
            },
            "offset": {
              "anyOf": [
                {
                  "$ref": "#/$defs/CompactDuration"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "sun"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "event"
          ]
        },
        {
          "type": "object",
          "properties": {
            "data": {
              "type": [
                "object",
                "null"
              ],
              "additionalProperties": false,
              "patternProperties": {
                "^[a-z0-9]+(_[a-z0-9]+)*$": {
                  "$ref": "#/$defs/EventDatum"
                }
              }
            },
            "event": {
              "$ref": "#/$defs/EventName"
            },
            "type": {
              "type": "string",
              "const": "event"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "event"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "startup"
            }
          },
          "additionalProperties": false,
          "required": [
            "type"
          ]
        }
      ]
    },
    "TypedValue": {
      "description": "A typed state value: bool, finite number, string, or null (unknown).",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "number"
        },
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ]
    },
    "Values": {
      "description": "A typed value, or a list of 1 to 16 of them: any one matches.",
      "anyOf": [
        {
          "$ref": "#/$defs/TypedValue"
        },
        {
          "type": "array",
          "items": {
            "$ref": "#/$defs/TypedValue"
          },
          "maxItems": 16,
          "minItems": 1,
          "uniqueItems": true
        }
      ]
    },
    "WaitUntil": {
      "description": "Level matcher for a wait: `state` or `expr`, never a trigger `to`.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "availability": {
              "anyOf": [
                {
                  "$ref": "#/$defs/AvailabilityWanted"
                },
                {
                  "type": "null"
                }
              ]
            },
            "entity": {
              "$ref": "#/$defs/EntityId"
            },
            "for": {
              "anyOf": [
                {
                  "$ref": "#/$defs/CompactDuration"
                },
                {
                  "type": "null"
                }
              ]
            },
            "is": {
              "anyOf": [
                {
                  "$ref": "#/$defs/TypedValue"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "state"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "entity"
          ]
        },
        {
          "type": "object",
          "properties": {
            "expr": {
              "$ref": "#/$defs/ExprString"
            },
            "for": {
              "anyOf": [
                {
                  "$ref": "#/$defs/CompactDuration"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "expr"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "expr"
          ]
        }
      ]
    },
    "Weekday": {
      "type": "string",
      "enum": [
        "mon",
        "tue",
        "wed",
        "thu",
        "fri",
        "sat",
        "sun"
      ]
    },
    "Wire": {
      "description": "From a node (`node` for its `out` port, or `node:port`) to a node.",
      "type": "array",
      "maxItems": 2,
      "minItems": 2,
      "prefixItems": [
        {
          "type": "string",
          "pattern": "^[a-z0-9]+(_[a-z0-9]+)*(:(out|yes|no|error|matched|timeout|else|case_[1-9][0-9]*))?$"
        },
        {
          "type": "string",
          "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"
        }
      ]
    },
    "Worked": {
      "description": "An expression giving a number, e.g. `var('level')` or `round(num('sensor.lux') / 10)`.",
      "type": "object",
      "properties": {
        "expr": {
          "$ref": "#/$defs/ExprString"
        }
      },
      "additionalProperties": false,
      "required": [
        "expr"
      ]
    }
  }
}
