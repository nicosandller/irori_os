{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Entity",
  "description": "The registry entry for an entity: its identity and what it can do. Its current value lives\nin [`crate::EntityState`].",
  "type": "object",
  "properties": {
    "area_id": {
      "description": "Overrides the device's area when set.",
      "anyOf": [
        {
          "$ref": "#/$defs/AreaId"
        },
        {
          "type": "null"
        }
      ]
    },
    "capabilities": {
      "$ref": "#/$defs/Capabilities"
    },
    "device_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/DeviceId"
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "description": "`<kind>.<object_id>`. Its kind must match `capabilities.kind`.",
      "$ref": "#/$defs/EntityId"
    },
    "integration": {
      "$ref": "#/$defs/IntegrationId"
    },
    "name": {
      "$ref": "#/$defs/Name"
    },
    "unique_id": {
      "description": "The integration's stable id for this entity. Survives renames of `id`.",
      "$ref": "#/$defs/UniqueId"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "id": {
            "pattern": "^light\\."
          }
        },
        "required": [
          "id"
        ]
      },
      "then": {
        "properties": {
          "capabilities": {
            "properties": {
              "kind": {
                "const": "light"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "id": {
            "pattern": "^switch\\."
          }
        },
        "required": [
          "id"
        ]
      },
      "then": {
        "properties": {
          "capabilities": {
            "properties": {
              "kind": {
                "const": "switch"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "id": {
            "pattern": "^sensor\\."
          }
        },
        "required": [
          "id"
        ]
      },
      "then": {
        "properties": {
          "capabilities": {
            "properties": {
              "kind": {
                "const": "sensor"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "id": {
            "pattern": "^binary_sensor\\."
          }
        },
        "required": [
          "id"
        ]
      },
      "then": {
        "properties": {
          "capabilities": {
            "properties": {
              "kind": {
                "const": "binary_sensor"
              }
            }
          }
        }
      }
    }
  ],
  "required": [
    "id",
    "integration",
    "unique_id",
    "name",
    "capabilities"
  ],
  "$defs": {
    "AreaId": {
      "description": "Format of a slug (area id): lowercase letters a-z and digits, in words separated by single `_`. 1-64 characters.",
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"
    },
    "BinarySensorClass": {
      "type": "string",
      "enum": [
        "motion",
        "occupancy",
        "door",
        "window",
        "moisture",
        "smoke",
        "gas",
        "vibration",
        "plug",
        "connectivity",
        "problem",
        "battery"
      ]
    },
    "Capabilities": {
      "description": "What an entity can do, per kind. Static facts that don't change with its state.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "brightness": {
              "description": "Supports dimming.",
              "type": "boolean",
              "default": false
            },
            "color_temp_kelvin": {
              "description": "Supports color temperature, within this range.",
              "anyOf": [
                {
                  "$ref": "#/$defs/ColorTempRange"
                },
                {
                  "type": "null"
                }
              ]
            },
            "kind": {
              "type": "string",
              "const": "light"
            },
            "rgb": {
              "description": "Supports RGB color.",
              "type": "boolean",
              "default": false
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "device_class": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SwitchClass"
                },
                {
                  "type": "null"
                }
              ]
            },
            "kind": {
              "type": "string",
              "const": "switch"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "device_class": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SensorClass"
                },
                {
                  "type": "null"
                }
              ]
            },
            "kind": {
              "type": "string",
              "const": "sensor"
            },
            "state_class": {
              "description": "How numeric readings accumulate, for history and statistics.",
              "anyOf": [
                {
                  "$ref": "#/$defs/StateClass"
                },
                {
                  "type": "null"
                }
              ]
            },
            "unit": {
              "description": "Unit of numeric readings, e.g. `°C`, `lx`, `%`, `W`, `kWh`.",
              "type": [
                "string",
                "null"
              ]
            },
            "value_type": {
              "description": "Whether readings are numbers or text. Rules are type-checked against this.",
              "$ref": "#/$defs/SensorValueType"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value_type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "device_class": {
              "anyOf": [
                {
                  "$ref": "#/$defs/BinarySensorClass"
                },
                {
                  "type": "null"
                }
              ]
            },
            "kind": {
              "type": "string",
              "const": "binary_sensor"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        }
      ]
    },
    "ColorTempRange": {
      "description": "Supported color temperatures in kelvin, `min` (warmest) to `max` (coolest).",
      "type": "object",
      "properties": {
        "max": {
          "type": "integer",
          "format": "uint16",
          "maximum": 20000,
          "minimum": 1000
        },
        "min": {
          "type": "integer",
          "format": "uint16",
          "maximum": 20000,
          "minimum": 1000
        }
      },
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ]
    },
    "DeviceId": {
      "description": "Format of a slug (device id): lowercase letters a-z and digits, in words separated by single `_`. 1-64 characters.",
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"
    },
    "EntityId": {
      "description": "An entity id: `<kind>.<object_id>`, e.g. `light.hallway`. The object id uses lowercase letters a-z and digits in words separated by single `_`, 1-64 characters.",
      "type": "string",
      "anyOf": [
        {
          "maxLength": 70,
          "pattern": "^light\\.[a-z0-9]+(_[a-z0-9]+)*$"
        },
        {
          "maxLength": 71,
          "pattern": "^switch\\.[a-z0-9]+(_[a-z0-9]+)*$"
        },
        {
          "maxLength": 71,
          "pattern": "^sensor\\.[a-z0-9]+(_[a-z0-9]+)*$"
        },
        {
          "maxLength": 78,
          "pattern": "^binary_sensor\\.[a-z0-9]+(_[a-z0-9]+)*$"
        }
      ]
    },
    "IntegrationId": {
      "description": "Format of a slug (integration id): lowercase letters a-z and digits, in words separated by single `_`. 1-64 characters.",
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"
    },
    "Name": {
      "description": "A human-readable name. 1-100 characters, no leading or trailing whitespace.",
      "type": "string",
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[^\\s\\u0000-\\u001F\\u007F-\\u009F]([^\\u0000-\\u001F\\u007F-\\u009F]*[^\\s\\u0000-\\u001F\\u007F-\\u009F])?$"
    },
    "SensorClass": {
      "type": "string",
      "enum": [
        "temperature",
        "humidity",
        "illuminance",
        "pressure",
        "power",
        "energy",
        "voltage",
        "current",
        "battery",
        "co2",
        "pm25",
        "signal_strength"
      ]
    },
    "SensorValueType": {
      "type": "string",
      "enum": [
        "number",
        "text"
      ]
    },
    "StateClass": {
      "oneOf": [
        {
          "description": "A current value, e.g. temperature.",
          "type": "string",
          "const": "measurement"
        },
        {
          "description": "A running total that can go up or down, e.g. net energy.",
          "type": "string",
          "const": "total"
        },
        {
          "description": "A counter that only increases, resetting occasionally, e.g. a meter reading.",
          "type": "string",
          "const": "total_increasing"
        }
      ]
    },
    "SwitchClass": {
      "type": "string",
      "enum": [
        "outlet",
        "switch"
      ]
    },
    "UniqueId": {
      "description": "Stable id assigned by the integration (e.g. a Zigbee IEEE address). Unique within the integration.",
      "type": "string",
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$"
    }
  }
}
