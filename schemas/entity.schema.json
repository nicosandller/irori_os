{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Entity",
  "description": "The registry entry for an entity: its identity and what it can do. Its current value lives\nin [`crate::EntityState`].",
  "type": "object",
  "properties": {
    "area_id": {
      "description": "Overrides the device's area when set.",
      "anyOf": [
        {
          "$ref": "#/$defs/AreaId"
        },
        {
          "type": "null"
        }
      ]
    },
    "capabilities": {
      "$ref": "#/$defs/Capabilities"
    },
    "device_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/DeviceId"
        },
        {
          "type": "null"
        }
      ]
    },
    "entity_category": {
      "description": "Whether it's one of the device's settings or diagnostics rather than something it's for.\nPages list these after the device's main entities.",
      "anyOf": [
        {
          "$ref": "#/$defs/EntityCategory"
        },
        {
          "type": "null"
        }
      ]
    },
    "id": {
      "description": "`<kind>.<object_id>`. Its kind must match `capabilities.kind`.",
      "$ref": "#/$defs/EntityId"
    },
    "name": {
      "$ref": "#/$defs/Name"
    },
    "protocol": {
      "$ref": "#/$defs/ProtocolId"
    },
    "unique_id": {
      "description": "The protocol's stable id for this entity. Survives renames of `id`.",
      "$ref": "#/$defs/UniqueId"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "id": {
            "pattern": "^light\\."
          }
        },
        "required": [
          "id"
        ]
      },
      "then": {
        "properties": {
          "capabilities": {
            "properties": {
              "kind": {
                "const": "light"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "id": {
            "pattern": "^switch\\."
          }
        },
        "required": [
          "id"
        ]
      },
      "then": {
        "properties": {
          "capabilities": {
            "properties": {
              "kind": {
                "const": "switch"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "id": {
            "pattern": "^sensor\\."
          }
        },
        "required": [
          "id"
        ]
      },
      "then": {
        "properties": {
          "capabilities": {
            "properties": {
              "kind": {
                "const": "sensor"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "id": {
            "pattern": "^binary_sensor\\."
          }
        },
        "required": [
          "id"
        ]
      },
      "then": {
        "properties": {
          "capabilities": {
            "properties": {
              "kind": {
                "const": "binary_sensor"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "id": {
            "pattern": "^number\\."
          }
        },
        "required": [
          "id"
        ]
      },
      "then": {
        "properties": {
          "capabilities": {
            "properties": {
              "kind": {
                "const": "number"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "id": {
            "pattern": "^select\\."
          }
        },
        "required": [
          "id"
        ]
      },
      "then": {
        "properties": {
          "capabilities": {
            "properties": {
              "kind": {
                "const": "select"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "id": {
            "pattern": "^text\\."
          }
        },
        "required": [
          "id"
        ]
      },
      "then": {
        "properties": {
          "capabilities": {
            "properties": {
              "kind": {
                "const": "text"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "id": {
            "pattern": "^button\\."
          }
        },
        "required": [
          "id"
        ]
      },
      "then": {
        "properties": {
          "capabilities": {
            "properties": {
              "kind": {
                "const": "button"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "id": {
            "pattern": "^event\\."
          }
        },
        "required": [
          "id"
        ]
      },
      "then": {
        "properties": {
          "capabilities": {
            "properties": {
              "kind": {
                "const": "event"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "id": {
            "pattern": "^cover\\."
          }
        },
        "required": [
          "id"
        ]
      },
      "then": {
        "properties": {
          "capabilities": {
            "properties": {
              "kind": {
                "const": "cover"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "id": {
            "pattern": "^lock\\."
          }
        },
        "required": [
          "id"
        ]
      },
      "then": {
        "properties": {
          "capabilities": {
            "properties": {
              "kind": {
                "const": "lock"
              }
            }
          }
        }
      }
    }
  ],
  "required": [
    "id",
    "protocol",
    "unique_id",
    "name",
    "capabilities"
  ],
  "$defs": {
    "AreaId": {
      "description": "Format of a slug (area id): lowercase letters a-z and digits, in words separated by single `_`. 1-64 characters.",
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"
    },
    "BinarySensorClass": {
      "description": "What a binary sensor's `on` means: Home Assistant's binary sensor device classes, by the\nsame names.",
      "type": "string",
      "enum": [
        "battery",
        "battery_charging",
        "carbon_monoxide",
        "cold",
        "connectivity",
        "door",
        "garage_door",
        "gas",
        "glass_break",
        "heat",
        "light",
        "lock",
        "moisture",
        "motion",
        "moving",
        "occupancy",
        "opening",
        "plug",
        "power",
        "presence",
        "problem",
        "running",
        "safety",
        "smoke",
        "sound",
        "tamper",
        "update",
        "vibration",
        "window"
      ]
    },
    "ButtonClass": {
      "description": "What pressing it does, when that's one of Home Assistant's.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "restart"
          ]
        },
        {
          "description": "Makes the device show itself: a blink, a beep.",
          "type": "string",
          "const": "identify"
        },
        {
          "description": "Installs an update the device has.",
          "type": "string",
          "const": "update"
        }
      ]
    },
    "Capabilities": {
      "description": "What an entity can do, per kind. Static facts that don't change with its state.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "brightness": {
              "description": "Supports dimming.",
              "type": "boolean",
              "default": false
            },
            "color_temp_kelvin": {
              "description": "Supports color temperature, within this range.",
              "anyOf": [
                {
                  "$ref": "#/$defs/ColorTempRange"
                },
                {
                  "type": "null"
                }
              ]
            },
            "kind": {
              "type": "string",
              "const": "light"
            },
            "rgb": {
              "description": "Supports RGB color.",
              "type": "boolean",
              "default": false
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "device_class": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SwitchClass"
                },
                {
                  "type": "null"
                }
              ]
            },
            "kind": {
              "type": "string",
              "const": "switch"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "device_class": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SensorClass"
                },
                {
                  "type": "null"
                }
              ]
            },
            "kind": {
              "type": "string",
              "const": "sensor"
            },
            "options": {
              "description": "Every text it can report, when that's a fixed list (a washing machine's program, Home\nAssistant's `enum` sensors). Only for text; readings outside it are refused, and rules\ncomparing it with text it can never have are refused when saved.",
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 256
            },
            "state_class": {
              "description": "How numeric readings accumulate, for history and statistics.",
              "anyOf": [
                {
                  "$ref": "#/$defs/StateClass"
                },
                {
                  "type": "null"
                }
              ]
            },
            "unit": {
              "description": "Unit of numeric readings, e.g. `°C`, `lx`, `%`, `W`, `kWh`.",
              "type": [
                "string",
                "null"
              ]
            },
            "value_type": {
              "description": "Whether readings are numbers or text. Rules are type-checked against this.",
              "$ref": "#/$defs/SensorValueType"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value_type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "device_class": {
              "anyOf": [
                {
                  "$ref": "#/$defs/BinarySensorClass"
                },
                {
                  "type": "null"
                }
              ]
            },
            "kind": {
              "type": "string",
              "const": "binary_sensor"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "device_class": {
              "description": "What it measures, from the same list as a sensor's.",
              "anyOf": [
                {
                  "$ref": "#/$defs/SensorClass"
                },
                {
                  "type": "null"
                }
              ]
            },
            "kind": {
              "type": "string",
              "const": "number"
            },
            "max": {
              "description": "The highest value it takes. Not below `min`.",
              "type": "number",
              "format": "double"
            },
            "min": {
              "description": "The lowest value it takes.",
              "type": "number",
              "format": "double"
            },
            "mode": {
              "description": "How a page should offer it.",
              "$ref": "#/$defs/NumberMode"
            },
            "step": {
              "description": "The smallest change that means anything, e.g. `0.5`. Above zero.",
              "type": "number",
              "format": "double"
            },
            "unit": {
              "description": "Unit of the value, e.g. `s`, `°C`, `%`.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "min",
            "max",
            "step"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "select"
            },
            "options": {
              "description": "Every choice it has, at least one.",
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 256,
              "minItems": 1
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "options"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "text"
            },
            "max_length": {
              "description": "The most characters it takes, at most 255.",
              "type": "integer",
              "format": "uint32",
              "default": 255,
              "maximum": 255,
              "minimum": 0
            },
            "min_length": {
              "description": "The fewest characters it takes.",
              "type": "integer",
              "format": "uint32",
              "default": 0,
              "maximum": 255,
              "minimum": 0
            },
            "mode": {
              "description": "Whether it's a secret, which pages don't show.",
              "$ref": "#/$defs/TextMode"
            },
            "pattern": {
              "description": "A regular expression the text has to match, as the device says. The device checks it;\nIrori shows it to whoever is typing.",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "device_class": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ButtonClass"
                },
                {
                  "type": "null"
                }
              ]
            },
            "kind": {
              "type": "string",
              "const": "button"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "device_class": {
              "anyOf": [
                {
                  "$ref": "#/$defs/EventClass"
                },
                {
                  "type": "null"
                }
              ]
            },
            "event_types": {
              "description": "Everything it can report happening, at least one, e.g. `single`, `double`, `long`.",
              "type": "array",
              "items": {
                "type": "string"
              },
              "maxItems": 256,
              "minItems": 1
            },
            "kind": {
              "type": "string",
              "const": "event"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "event_types"
          ]
        },
        {
          "type": "object",
          "properties": {
            "device_class": {
              "anyOf": [
                {
                  "$ref": "#/$defs/CoverClass"
                },
                {
                  "type": "null"
                }
              ]
            },
            "kind": {
              "type": "string",
              "const": "cover"
            },
            "position": {
              "description": "Can be sent to a position between open and closed, and says where it is.",
              "type": "boolean",
              "default": false
            },
            "stop": {
              "description": "Can be stopped while it's moving.",
              "type": "boolean",
              "default": false
            },
            "tilt": {
              "description": "Has slats that tilt, and says how far.",
              "type": "boolean",
              "default": false
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "code_format": {
              "description": "A regular expression the code matches, as the device says. The device checks it; pages\nshow it to whoever is typing.",
              "type": [
                "string",
                "null"
              ]
            },
            "kind": {
              "type": "string",
              "const": "lock"
            },
            "open": {
              "description": "Can open the door as well as unlock it, e.g. by pulling the latch.",
              "type": "boolean",
              "default": false
            },
            "requires_code": {
              "description": "Needs a code to lock, unlock or open.",
              "type": "boolean",
              "default": false
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        }
      ]
    },
    "ColorTempRange": {
      "description": "Supported color temperatures in kelvin, `min` (warmest) to `max` (coolest).",
      "type": "object",
      "properties": {
        "max": {
          "type": "integer",
          "format": "uint16",
          "maximum": 20000,
          "minimum": 1000
        },
        "min": {
          "type": "integer",
          "format": "uint16",
          "maximum": 20000,
          "minimum": 1000
        }
      },
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ]
    },
    "CoverClass": {
      "description": "What it covers, when that's one of Home Assistant's.",
      "type": "string",
      "enum": [
        "awning",
        "blind",
        "curtain",
        "damper",
        "door",
        "garage",
        "gate",
        "shade",
        "shutter",
        "window"
      ]
    },
    "DeviceId": {
      "description": "Format of a slug (device id): lowercase letters a-z and digits, in words separated by single `_`. 1-64 characters.",
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"
    },
    "EntityCategory": {
      "description": "What an entity is to its device, when it isn't what the device is for: a light's power-on\nbehaviour is a setting, its signal strength a diagnostic. Home Assistant's names.\nOrdered as pages list them: settings before diagnostics, and both after an entity with none.",
      "oneOf": [
        {
          "description": "Changes how the device behaves, e.g. a motion sensor's timeout.",
          "type": "string",
          "const": "config"
        },
        {
          "description": "Tells how the device is doing, e.g. its signal strength or firmware version.",
          "type": "string",
          "const": "diagnostic"
        }
      ]
    },
    "EntityId": {
      "description": "An entity id: `<kind>.<object_id>`, e.g. `light.hallway`. The object id uses lowercase letters a-z and digits in words separated by single `_`, 1-64 characters.",
      "type": "string",
      "anyOf": [
        {
          "maxLength": 70,
          "pattern": "^light\\.[a-z0-9]+(_[a-z0-9]+)*$"
        },
        {
          "maxLength": 71,
          "pattern": "^switch\\.[a-z0-9]+(_[a-z0-9]+)*$"
        },
        {
          "maxLength": 71,
          "pattern": "^sensor\\.[a-z0-9]+(_[a-z0-9]+)*$"
        },
        {
          "maxLength": 78,
          "pattern": "^binary_sensor\\.[a-z0-9]+(_[a-z0-9]+)*$"
        },
        {
          "maxLength": 71,
          "pattern": "^number\\.[a-z0-9]+(_[a-z0-9]+)*$"
        },
        {
          "maxLength": 71,
          "pattern": "^select\\.[a-z0-9]+(_[a-z0-9]+)*$"
        },
        {
          "maxLength": 69,
          "pattern": "^text\\.[a-z0-9]+(_[a-z0-9]+)*$"
        },
        {
          "maxLength": 71,
          "pattern": "^button\\.[a-z0-9]+(_[a-z0-9]+)*$"
        },
        {
          "maxLength": 70,
          "pattern": "^event\\.[a-z0-9]+(_[a-z0-9]+)*$"
        },
        {
          "maxLength": 70,
          "pattern": "^cover\\.[a-z0-9]+(_[a-z0-9]+)*$"
        },
        {
          "maxLength": 69,
          "pattern": "^lock\\.[a-z0-9]+(_[a-z0-9]+)*$"
        }
      ]
    },
    "EventClass": {
      "description": "What kind of thing it reports happening, when that's one of Home Assistant's.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "doorbell",
            "motion"
          ]
        },
        {
          "description": "A button being pressed: a remote's, a wall switch's.",
          "type": "string",
          "const": "button"
        }
      ]
    },
    "Name": {
      "description": "A human-readable name. 1-100 characters, no leading or trailing whitespace.",
      "type": "string",
      "maxLength": 100,
      "minLength": 1,
      "pattern": "^[^\\u0020\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF\\u0000-\\u001F\\u007F-\\u009F]([^\\u0000-\\u001F\\u007F-\\u009F]*[^\\u0020\\u00A0\\u1680\\u2000-\\u200A\\u2028\\u2029\\u202F\\u205F\\u3000\\uFEFF\\u0000-\\u001F\\u007F-\\u009F])?$"
    },
    "NumberMode": {
      "description": "How a page offers a number: a slider, a box to type in, or whichever suits the range.",
      "type": "string",
      "enum": [
        "auto",
        "slider",
        "box"
      ]
    },
    "ProtocolId": {
      "description": "Format of a slug (protocol id): lowercase letters a-z and digits, in words separated by single `_`. 1-64 characters.",
      "type": "string",
      "maxLength": 64,
      "minLength": 1,
      "pattern": "^[a-z0-9]+(_[a-z0-9]+)*$"
    },
    "SensorClass": {
      "description": "What a sensor measures: Home Assistant's sensor device classes, by the same names. A\nsensor whose readings come from a fixed list says so with `options` instead of a class.",
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "absolute_humidity",
            "apparent_power",
            "aqi",
            "area",
            "atmospheric_pressure",
            "battery",
            "blood_glucose_concentration",
            "carbon_monoxide",
            "conductivity",
            "current",
            "data_rate",
            "data_size",
            "date",
            "distance",
            "duration",
            "energy",
            "energy_distance",
            "energy_storage",
            "frequency",
            "gas",
            "humidity",
            "illuminance",
            "irradiance",
            "moisture",
            "monetary",
            "nitrogen_dioxide",
            "nitrogen_monoxide",
            "nitrous_oxide",
            "ozone",
            "ph",
            "pm1",
            "pm10",
            "pm25",
            "pm4",
            "power",
            "power_factor",
            "precipitation",
            "precipitation_intensity",
            "pressure",
            "radon",
            "reactive_energy",
            "reactive_power",
            "signal_strength",
            "sound_pressure",
            "speed",
            "sulphur_dioxide",
            "temperature",
            "temperature_delta",
            "timestamp",
            "uptime",
            "volatile_organic_compounds",
            "volatile_organic_compounds_parts",
            "voltage",
            "volume",
            "volume_flow_rate",
            "volume_storage",
            "water",
            "weight",
            "wind_direction",
            "wind_speed"
          ]
        },
        {
          "description": "Carbon dioxide; Home Assistant's `carbon_dioxide`.",
          "type": "string",
          "const": "co2"
        }
      ]
    },
    "SensorValueType": {
      "type": "string",
      "enum": [
        "number",
        "text"
      ]
    },
    "StateClass": {
      "oneOf": [
        {
          "description": "A current value, e.g. temperature.",
          "type": "string",
          "const": "measurement"
        },
        {
          "description": "A running total that can go up or down, e.g. net energy.",
          "type": "string",
          "const": "total"
        },
        {
          "description": "A counter that only increases, resetting occasionally, e.g. a meter reading.",
          "type": "string",
          "const": "total_increasing"
        }
      ]
    },
    "SwitchClass": {
      "type": "string",
      "enum": [
        "outlet",
        "switch"
      ]
    },
    "TextMode": {
      "type": "string",
      "enum": [
        "text",
        "password"
      ]
    },
    "UniqueId": {
      "description": "Stable id assigned by the protocol (e.g. a Zigbee IEEE address). Unique within the protocol.",
      "type": "string",
      "maxLength": 255,
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001F\\u007F-\\u009F]+$"
    }
  }
