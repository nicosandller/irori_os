# Keep the Docker build context small (dev/Dockerfile uses the repo root).
.git
target
**/target
crates/irori-ui/dist
extensions/automations/app/dist
# The image builds the pages itself and copies them in. A UI built on the host
# must not be the one the binary embeds.
crates/irori/ui/*
!crates/irori/ui/.gitkeep
data
.qa-shots-*
**/.DS_Store
.claude
